// Prisma schema for the inventory management system.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  password          String
  role              Role               @default(STAFF)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                     String                  @id @default(cuid())
  sku                    String                  @unique
  name                   String
  unit                   String
  reorderPoint           Int                     @default(0)
  categoryId             String
  category               Category                @relation(fields: [categoryId], references: [id])
  stockLevels            StockLevel[]
  stockTransactions      StockTransaction[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // Trigram GIN indexes on name/sku for fast ILIKE search at scale are
  // managed via raw SQL in the add_search_indexes migration (Prisma's
  // schema language doesn't model pg_trgm operator classes).
  @@index([name])
  @@index([categoryId, name])
}

model Location {
  id                String             @id @default(cuid())
  name              String             @unique
  address           String?
  stockLevels       StockLevel[]
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model StockLevel {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model Supplier {
  id             String          @id @default(cuid())
  name           String          @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String                  @id @default(cuid())
  status      PurchaseOrderStatus     @default(DRAFT)
  supplierId  String
  supplier    Supplier                @relation(fields: [supplierId], references: [id])
  // The location stock is received into when this order is marked RECEIVED.
  // Nullable so the column can be added without a backfill; the API
  // requires it when creating a new purchase order.
  locationId  String?
  location    Location?               @relation(fields: [locationId], references: [id])
  note        String?
  createdById String
  createdBy   User                    @relation(fields: [createdById], references: [id])
  submittedAt DateTime?
  receivedAt  DateTime?
  lineItems   PurchaseOrderLineItem[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([locationId])
}

model PurchaseOrderLineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCostCents   Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockTransaction {
  id          String               @id @default(cuid())
  type        StockTransactionType
  quantity    Int
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id])
  note        String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
}

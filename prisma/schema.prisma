// Prisma schema for the inventory management system.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  password          String
  role              Role               @default(STAFF)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockTransactions StockTransaction[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                String             @id @default(cuid())
  sku               String             @unique
  name              String
  unit              String
  reorderPoint      Int                @default(0)
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id])
  stockLevels       StockLevel[]
  stockTransactions StockTransaction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Trigram GIN indexes on name/sku for fast ILIKE search at scale are
  // managed via raw SQL in the add_search_indexes migration (Prisma's
  // schema language doesn't model pg_trgm operator classes).
  @@index([name])
  @@index([categoryId, name])
}

model Location {
  id                String             @id @default(cuid())
  name              String             @unique
  address           String?
  stockLevels       StockLevel[]
  stockTransactions StockTransaction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model StockLevel {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([locationId])
}

enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockTransaction {
  id          String               @id @default(cuid())
  type        StockTransactionType
  quantity    Int
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id])
  note        String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
}

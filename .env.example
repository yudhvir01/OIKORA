# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/inventory_management"

# Secret used by Auth.js (NextAuth) to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# SMTP settings used to send low-stock alert emails (src/lib/email.ts).
# Leave SMTP_HOST unset to have alert emails logged to the console instead
# of sent, which is fine for local development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="inventory-alerts@localhost"

# Recipient address for POST /api/alerts/low-stock/notify.
ALERT_EMAIL_TO=""
